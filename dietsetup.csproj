<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods</OutputPath>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Overridable via -p:DietSetupDeployPath=... . Defaults to the Mods junction itself, not its
       target, so deploy follows whichever profile the junction points at without this file
       naming it. -->
  <PropertyGroup>
    <DietSetupDeployPath Condition="'$(DietSetupDeployPath)' == ''">$(VINTAGE_STORY_DATA)\Mods\dietsetup</DietSetupDeployPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- DLL + PDB + modinfo.json, plus a full mirror of assets\. ContinueOnError defaults to
       false throughout: a failed copy fails the build, not a silent skip (2026-09-01 session
       read a stale deployed binary three times over exactly that gap). -->
  <Target Name="DeployMod" AfterTargets="Build">
    <ItemGroup>
      <DietSetupDeployFiles Include="$(TargetPath)" />
      <DietSetupDeployFiles Include="$(TargetDir)$(TargetName).pdb" />
      <DietSetupDeployFiles Include="$(MSBuildProjectDirectory)\modinfo.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DietSetupDeployFiles)" DestinationFolder="$(DietSetupDeployPath)" ContinueOnError="false" />

    <!-- Mirror, not merge: every deployed file whose path isn't produced by this transform
         (e.g. dev-inedible-fixture.json, hand-copied in for testing) gets deleted. Dev diet
         fixtures (architecture §11) belong in ModConfig/dietsetup/diets/, not here, so they're
         excluded from the source side too; that also lets the same Delete step above sweep
         away a stray dev-*.json a previous build already deployed. -->
    <ItemGroup>
      <DietSetupSourceAssets Include="$(MSBuildProjectDirectory)\assets\**\*" Exclude="$(MSBuildProjectDirectory)\assets\dietsetup\config\diets\dev-*.json" />
      <DietSetupExcludedDevDiets Include="$(MSBuildProjectDirectory)\assets\dietsetup\config\diets\dev-*.json" />
      <DietSetupExpectedAssets Include="@(DietSetupSourceAssets->'$(DietSetupDeployPath)\assets\%(RecursiveDir)%(Filename)%(Extension)')" />
      <DietSetupStaleAssets Include="$(DietSetupDeployPath)\assets\**\*" Exclude="@(DietSetupExpectedAssets)" />
    </ItemGroup>
    <Message Importance="high" Text="Excluded dev diet fixture from deploy: %(DietSetupExcludedDevDiets.Identity)" Condition="'@(DietSetupExcludedDevDiets)' != ''" />
    <Delete Files="@(DietSetupStaleAssets)" ContinueOnError="false" />
    <Copy SourceFiles="@(DietSetupSourceAssets)" DestinationFiles="@(DietSetupExpectedAssets)" ContinueOnError="false" />
    <Message Importance="high" Text="Deployed dietsetup assets: @(DietSetupSourceAssets->Count()) copied, @(DietSetupStaleAssets->Count()) deleted" />
    <Message Importance="high" Text="Deployed dietsetup to $(DietSetupDeployPath)" />
  </Target>

</Project>
