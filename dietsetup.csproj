<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods</OutputPath>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Overridable via -p:DietSetupDeployPath=... . Defaults to the Mods junction itself, not its
       target, so deploy follows whichever profile the junction points at without this file
       naming it. -->
  <PropertyGroup>
    <DietSetupDeployPath Condition="'$(DietSetupDeployPath)' == ''">$(VINTAGE_STORY_DATA)\Mods\dietsetup</DietSetupDeployPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- DLL + PDB only, nothing else; deps.json etc. stay out of the deploy folder.
       ContinueOnError defaults to false: a failed copy fails the build, not a silent skip
       (2026-09-01 session read a stale deployed binary three times over exactly that gap). -->
  <Target Name="DeployMod" AfterTargets="Build">
    <ItemGroup>
      <DietSetupDeployFiles Include="$(TargetPath)" />
      <DietSetupDeployFiles Include="$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(DietSetupDeployFiles)" DestinationFolder="$(DietSetupDeployPath)" ContinueOnError="false" />
    <Message Importance="high" Text="Deployed dietsetup to $(DietSetupDeployPath)" />
  </Target>

</Project>
