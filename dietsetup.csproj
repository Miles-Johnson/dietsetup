<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods</OutputPath>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Overridable via -p:DietSetupDeployPath=... . Defaults to the Mods junction itself, not its
       target, so deploy follows whichever profile the junction points at without this file
       naming it. -->
  <PropertyGroup>
    <DietSetupDeployPath Condition="'$(DietSetupDeployPath)' == ''">$(VINTAGE_STORY_DATA)\Mods\dietsetup</DietSetupDeployPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VINTAGE_STORY)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VINTAGE_STORY)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VINTAGE_STORY)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VINTAGE_STORY)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VINTAGE_STORY)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VINTAGE_STORY)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Stamps GitInfo.g.cs with the short SHA + dirty flag so a running build can log what it
       actually is (Phase A). git absent/unavailable -> "unknown", never a build failure. -->
  <Target Name="GenerateGitInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="DietSetupGitShaOutput" />
    </Exec>
    <Exec Command="git status --porcelain" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="DietSetupGitStatusOutput" />
    </Exec>
    <PropertyGroup>
      <DietSetupGitSha Condition="'@(DietSetupGitShaOutput)' != ''">@(DietSetupGitShaOutput)</DietSetupGitSha>
      <DietSetupGitSha Condition="'$(DietSetupGitSha)' == ''">unknown</DietSetupGitSha>
      <DietSetupGitDirty Condition="'@(DietSetupGitStatusOutput)' != ''">true</DietSetupGitDirty>
      <DietSetupGitDirty Condition="'$(DietSetupGitDirty)' == ''">false</DietSetupGitDirty>
    </PropertyGroup>
    <ItemGroup>
      <DietSetupGitInfoLines Include="internal static class GitInfo" />
      <DietSetupGitInfoLines Include="{" />
      <DietSetupGitInfoLines Include="    public const string Sha = &quot;$(DietSetupGitSha)&quot;%3b" />
      <DietSetupGitInfoLines Include="    public const bool Dirty = $(DietSetupGitDirty)%3b" />
      <DietSetupGitInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)GitInfo.g.cs" Lines="@(DietSetupGitInfoLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GitInfo.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Stages, mirrors to the client Mods folder, and (Release only) zips + copies to
       $(MOD_STAGING_PATH), all from the single exclude list owned by Package.ps1, so the
       client folder and the server zip can never diverge from each other (Phase A D1/D6).
       Gated behind DietSetupDeploy (default off): this target used to run unconditionally on
       every build, which meant a plain `dotnet build`, including a throwaway test build,
       silently overwrote the live install. Pass -p:DietSetupDeploy=true for a real deploy. -->
  <Target Name="Deploy" AfterTargets="Build" Condition="'$(DietSetupDeploy)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Package.ps1&quot; -Dll &quot;$(TargetPath)&quot; -Pdb &quot;$(TargetDir)$(TargetName).pdb&quot; -DeployPath &quot;$(DietSetupDeployPath)&quot; -StagingPath &quot;$(MOD_STAGING_PATH)&quot; -Configuration $(Configuration)" ContinueOnError="false" />
  </Target>

</Project>
